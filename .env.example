# Серверная база PostgreSQL. Для локального запуска npm run local:crm не требуется.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Задайте собственные длинные случайные значения перед размещением на сервере.
AUTH_SECRET=""
CLIENT_AUTH_SECRET=""
APP_PASSWORD=""

# Telegram подключается отдельно. Отправка наружу выключена по умолчанию.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_OUTBOX_LIVE_SEND="0"
